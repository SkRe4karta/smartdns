[Unit]
Description=SmartDNS gateway
After=network-online.target haproxy.service
[Service]
ExecStart=/opt/smartdns/current/venv/bin/smartdns-gateway
Environment=SMARTDNS_CONFIG=/etc/smartdns/settings.json
User=smartdns
Group=smartdns
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
MemoryMax=128M
LimitNOFILE=1024
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0007
ReadWritePaths=/var/lib/smartdns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
