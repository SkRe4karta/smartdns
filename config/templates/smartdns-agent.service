[Unit]
Description=SmartDNS agent
After=network-online.target haproxy.service
[Service]
ExecStart=/opt/smartdns/current/venv/bin/smartdns-agent
Environment=SMARTDNS_CONFIG=/etc/smartdns/settings.json
User=root
Group=smartdns
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
MemoryMax=128M
LimitNOFILE=1024
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0007
ReadWritePaths=/var/lib/smartdns
RuntimeDirectory=smartdns
RuntimeDirectoryMode=0750
Environment=SMARTDNS_MANAGE_HOST=1
ReadWritePaths=/var/lib/smartdns-agent /etc/haproxy /run/haproxy /run/smartdns
CapabilityBoundingSet=CAP_NET_ADMIN
[Install]
WantedBy=multi-user.target
